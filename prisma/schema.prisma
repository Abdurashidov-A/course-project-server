generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum RoleName {
  CANDIDATE
  RECRUITER
  ADMIN
}

enum CvStatus {
  DRAFT
  PUBLISHED
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String
  avatarUrl String?
  status    UserStatus @default(ACTIVE)
  version   Int        @default(1)

  roles                  UserRole[]
  cvs                    Cv[]
  cvLikes                CvLike[]
  projects               Project[]
  profileAttributeValues ProfileAttributeValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id   String   @id @default(cuid())
  name RoleName @unique

  users UserRole[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

enum AttributeCategory {
  PERSONAL_INFORMATION
  CERTIFICATION
  DOMAIN_KNOWLEDGE
  SOFT_SKILLS
  TECHNICAL_SKILLS
  LANGUAGE
  EDUCATION
  EXPERIENCE
  OTHER
}

enum AttributeType {
  STRING
  TEXT
  IMAGE
  NUMERIC
  DATE
  PERIOD
  BOOLEAN
  SELECT
}

model Attribute {
  id          Int               @id @default(autoincrement())
  name        String            @unique
  category    AttributeCategory
  type        AttributeType
  description String?
  version     Int               @default(1)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  options            AttributeOption[]
  positionAttributes PositionAttribute[]
  profileValues      ProfileAttributeValue[]
}

model AttributeOption {
  id          Int      @id @default(autoincrement())
  attributeId Int
  value       String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([attributeId, value])
}

model Position {
  id               Int      @id @default(autoincrement())
  title            String
  shortDescription String?
  isPublic         Boolean  @default(true)
  maxProjects      Int      @default(3)
  projectTags      String[] @default([])
  version          Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  attributes PositionAttribute[]
  cvs        Cv[]
}

model Cv {
  id         Int      @id @default(autoincrement())
  userId     String
  positionId Int
  status     CvStatus @default(DRAFT)
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  likes    CvLike[]

  @@unique([userId, positionId])
}

model CvLike {
  id        Int      @id @default(autoincrement())
  cvId      Int
  userId    String
  createdAt DateTime @default(now())

  cv   Cv   @relation(fields: [cvId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cvId, userId])
  @@index([cvId])
  @@index([userId])
}

model PositionAttribute {
  id          Int      @id @default(autoincrement())
  positionId  Int
  attributeId Int
  isRequired  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  position  Position  @relation(fields: [positionId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Restrict)

  @@unique([positionId, attributeId])
}

model ProfileAttributeValue {
  id Int @id @default(autoincrement())

  userId      String
  attributeId Int

  stringValue  String?
  textValue    String?
  numericValue Float?
  booleanValue Boolean?
  dateValue    DateTime?
  periodStart  DateTime?
  periodEnd    DateTime?
  imageUrl     String?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([userId, attributeId])
}

model Project {
  id             Int       @id @default(autoincrement())
  userId         String
  name           String
  description    String?
  periodStart    DateTime?
  periodEnd      DateTime?
  technologyTags String[]  @default([])
  version        Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
